# Server & Database Configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/team-task-board
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=production

# Single-domain Frontend Static Distribution Path (optional, auto-detected if empty)
# FRONTEND_DIST_PATH=frontend/dist

# Client URL (optional for cross-origin CORS, omitted when serving from same domain)
# CLIENT_URL=http://localhost:5000

# Frontend Development Configuration
VITE_API_PROXY=http://localhost:5000
# VITE_SOCKET_URL= (leave empty when deploying single-domain to auto-connect to current origin)
